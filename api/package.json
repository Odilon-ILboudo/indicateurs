  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate:secret": "node ./scripts/generateSecret.js",
    "seed": "node dist/seeders",
    "migration:generate": "typeorm migration:generate -d dist/typeorm.config.js",
    "migration:run": "typeorm migration:run -d dist/typeorm.config.js",
    "migration:revert": "typeorm migration:revert -d dist/typeorm.config.js",
    "schema:sync": "typeorm schema:sync",
    "seed:indicators": "ts-node src/scripts/seeds/activity-attempts-indicator.ts"
  },
