# ============================================
# BASE DE DONNÉES PLATON (lecture seule)
# Nom du container Docker PLaTon : platon_postgres
# ============================================
PLATON_DB_HOST=platon_postgres
PLATON_DB_PORT=5432
PLATON_DB_USERNAME=platon
PLATON_DB_PASSWORD=
PLATON_DB_NAME=platon_db

# ============================================
# BASE DE DONNÉES INDICATEURS (lecture/écriture)
# Même serveur PostgreSQL, base distincte
# ============================================
INDICATORS_DB_HOST=platon_postgres
INDICATORS_DB_PORT=5432
INDICATORS_DB_USERNAME=platon
INDICATORS_DB_PASSWORD=
INDICATORS_DB_NAME=indicators

# ============================================
# SERVICES PARTAGÉS AVEC PLATON
# ============================================

# JWT - doit être identique au SECRET_KEY du .env PLaTon
JWT_SECRET=

# Redis (container PLaTon : platon_redis)
REDIS_HOST=platon_redis
REDIS_PORT=6379

# ============================================
# RABBITMQ (propre au microservice indicateurs)
# Container : indicateurs_rabbitmq
# ============================================
RABBITMQ_URI=amqp://guest:guest@indicateurs_rabbitmq:5672

# ============================================
# API
# ============================================
NODE_ENV=production
PORT=3001

# ============================================
# FRONTEND
# Port exposé sur l'hôte pour le container Nginx du frontend
# ============================================
INDICATEURS_PORT=4300
