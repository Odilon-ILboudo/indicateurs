# =========================================================
# Angular + NestJS + TypeScript Full .gitignore
# =========================================================

# =========================================================
# Dependencies
# =========================================================
node_modules/
jspm_packages/
bower_components/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================================================
# Build outputs
# =========================================================

# Angular
dist/
.angular/
.out-tsc/
bazel-out/

# NestJS
build/
dist-nest/

# General
tmp/
temp/
out/
release/
debug/

# TypeScript
*.tsbuildinfo

# =========================================================
# Environment files
# =========================================================
.env
.env.*
!.env.example

# =========================================================
# Logs
# =========================================================
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# =========================================================
# Coverage / Tests
# =========================================================
coverage/
.nyc_output/

# Jest
jest-html-reporters-*
junit.xml

# Cypress
cypress/videos/
cypress/screenshots/
cypress/downloads/

# Playwright
playwright-report/
test-results/

# Screenshots
__screenshots__/

# =========================================================
# Angular cache
# =========================================================
.angular/cache/

# =========================================================
# NestJS specific
# =========================================================
uploads/
storage/
public/uploads/

# =========================================================
# Database
# =========================================================
*.sqlite
*.sqlite3
*.db

# Prisma
prisma/dev.db
prisma/dev.db-journal

# =========================================================
# IDEs / Editors
# =========================================================

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# JetBrains
.idea/
*.iml

# Eclipse
.project
.classpath
.settings/

# Sublime
*.sublime-project
*.sublime-workspace

# Cloud9
.c9/

# Visual Studio
.vs/

# =========================================================
# OS files
# =========================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =========================================================
# Docker
# =========================================================
# .docker/ contient les Dockerfiles/nginx.conf réels du build - suivis par git,
# jamais ignorés (docker-compose.*.yml en dépend comme contexte de build).

# Docker compose overrides
docker-compose.override.yml

# =========================================================
# Misc
# =========================================================
.sass-cache/
connect.lock
libpeerconnection.log
testem.log
typings/

# Local config
.local/
.cache/

# Generated files
*.tgz

# =========================================================
# Firebase / Supabase / AWS
# =========================================================
.firebase/
.supabase/
.serverless/

# =========================================================
# Turbo / Nx / Monorepo
# =========================================================
.nx/
turbo/